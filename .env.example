# Database (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/greenhub
# Neon:  postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/greenhub?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/greenhub"

# Auth (NextAuth.js / Auth.js)
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"

# Set to true when deploying behind a proxy/CDN (e.g. Vercel, Cloudflare)
AUTH_TRUST_HOST="true"

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000 (or your production URL)
# Callback URL:  http://localhost:3000/api/auth/callback/github (or https://<domain>/api/auth/callback/github)
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# Email (Resend)
# Create an API key at: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="GreenHub <onboarding@resend.dev>"

# Cron endpoint security
# Used to authenticate requests to /api/cron/notify
CRON_SECRET="a-secret-string-for-cron-endpoint"

# Optional
NODE_ENV="development"
TIMEZONE="America/New_York"
